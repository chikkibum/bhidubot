# Copy to .env and adjust. Local values target docker compose (Postgres, Floci, Mailpit).

# app
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:5173
API_PORT=3001

# database
DATABASE_URL=postgres://bhidubot:bhidubot@localhost:5432/bhidubot

# aws (Floci locally; remove AWS_ENDPOINT_URL for real AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=bhidubot-media
SQS_JOBS_QUEUE=bhidubot-jobs
SQS_JOBS_DLQ=bhidubot-jobs-dlq

# auth
# REQUIRED: generate a random secret of 32+ chars and set it below, e.g.
#   openssl rand -base64 32
#   bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Left empty on purpose: the app refuses to boot until you set it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Comma-separated email domains that may sign up without an invite (empty = invite-only, no domain auto-allow)
ALLOWED_SIGNUP_DOMAINS=

# email (Mailpit locally)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=bhidubot <no-reply@bhidubot.local>

# observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
