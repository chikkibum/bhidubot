{
  "name": "bhidubot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "latest",
    "turbo": "^2.11.10",
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.4.4"
}
